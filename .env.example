# Copy to .env and edit. docker compose passes every line into the container.
# .env is ignored by git: never commit it.

# --- Access -----------------------------------------------------------------------------------------------
# Either set a token (required when CARDPRESS_BIND is not 127.0.0.1) ...
# CARDPRESS_API_TOKEN=            # a long random value: openssl rand -hex 24
# ... or, for a loopback-only setup, tell the server nothing else is exposed.
CARDPRESS_INSECURE=1

# Where the port is published, and which port. 127.0.0.1 keeps it on this machine.
CARDPRESS_BIND=127.0.0.1
CARDPRESS_PORT=8080

# Image tag to run (latest, a version like v0.1.0, or main).
CARDPRESS_IMAGE_TAG=latest

# --- Stored credentials ------------------------------------------------------------------------------------
# Encrypts the social credentials saved in the app (at least 32 characters). Required when exposed.
# Without it a key file is created in the data volume (single-user, loopback setups only).
# CARDPRESS_SECRET_KEY=           # openssl rand -hex 32

# --- Assistant (chat) --------------------------------------------------------------------------------------
# Default is a built-in demo with no AI. To use a Claude Managed Agent: run
#   docker compose run --rm -e ANTHROPIC_API_KEY=... cardpress agent-setup
# then fill these in. See docs/cma-agent.md.
# CARDPRESS_AGENT=cma
# CARDPRESS_AGENT_ID=
# CARDPRESS_AGENT_ENVIRONMENT_ID=
# ANTHROPIC_API_KEY=
# CARDPRESS_AGENT_BUDGET_CENTS=500   # spend cap per conversation
# CARDPRESS_AGENT_TIMEOUT=4m

# --- Optional ----------------------------------------------------------------------------------------------
# CARDPRESS_MCP=true                 # MCP endpoint at /mcp
# CARDPRESS_ALLOWED_HOSTS=           # extra host names when there is no token
# CARDPRESS_CORS_ORIGINS=            # a separately hosted web app
# CARDPRESS_MISSED_GRACE=15m         # how late a scheduled post may still go out

# --- Database ----------------------------------------------------------------------------------------------
# Default: a SQLite file in the cardpress-data volume. For Turso instead, set both (and CARDPRESS_SECRET_KEY):
# CARDPRESS_DB_URL=libsql://<db>-<org>.turso.io
# CARDPRESS_DB_TOKEN=
