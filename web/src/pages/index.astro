---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const editor = `${base}studio/`;
const features = [
  { title: "Design", text: "Branded cards in every LinkedIn, X, Instagram and Facebook size." },
  { title: "Draft", text: "An assistant writes from an article. You approve every word." },
  { title: "Publish", text: "Preview, schedule, and post to LinkedIn. Always your click." },
];
---
<Base title="CardPress">
  <div class="flex min-h-screen flex-col" style="background-image: radial-gradient(1200px 500px at 50% -10%, var(--header-from), transparent 70%), radial-gradient(900px 400px at 100% 0%, var(--header-to), transparent 70%);">
    <header class="mx-auto flex w-full max-w-5xl items-center gap-3 px-6 py-5">
      <Mark />
      <span class="text-[22px] font-bold leading-none tracking-tight">CardPress</span>
      <span class="flex-1"></span>
      <a href="https://github.com/senthilsweb/cardpress" class="hidden text-sm text-muted-foreground hover:text-foreground sm:inline">GitHub</a>
      <a id="sign-in" href={`${base}login/`} hidden class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium hover:bg-accent">Sign in</a>
      <a href={editor} class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:opacity-90">Open editor</a>
    </header>

    <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col px-6">
      <section class="py-16 text-center sm:py-24">
        <h1 class="mx-auto max-w-3xl text-4xl font-bold leading-[1.08] tracking-tight sm:text-6xl">Write it. Design it. Post it.</h1>
        <p class="mx-auto mt-5 max-w-xl text-lg text-muted-foreground">An agent drafts, you approve. Open source and self-hosted.</p>
        <div class="mt-8 flex items-center justify-center gap-3">
          <a href={editor} class="rounded-lg bg-brand px-6 py-3 text-base font-medium text-on-brand shadow-sm hover:opacity-90">Open the editor</a>
          <a href="https://www.senthilsweb.com/cardpress/" class="rounded-lg border border-border bg-card px-6 py-3 text-base font-medium hover:bg-accent">Read the docs</a>
        </div>
      </section>

      <section class="mx-auto w-full max-w-5xl">
        <div class="overflow-hidden rounded-2xl border border-border bg-card p-2 shadow-[0_30px_80px_-24px_rgba(10,59,51,0.35)]">
          <img src={`${base}demo/cardpress-demo.gif`} width="880" height="527" alt="Asking for a greeting in the chat, designing the card and previewing it, then the library, calendar and themes in CardPress" class="block h-auto w-full rounded-xl" loading="eager" decoding="async" />
        </div>
      </section>

      <section class="grid gap-6 py-16 sm:grid-cols-3 sm:py-24">
        {features.map((f) => (
          <div>
            <h2 class="eyebrow">{f.title}</h2>
            <p class="mt-2 text-base leading-snug">{f.text}</p>
          </div>
        ))}
      </section>
    </main>

    <footer class="mx-auto w-full max-w-5xl px-6 py-8 text-sm text-muted-foreground">
      Open source under the MIT license. Built with <span aria-label="love" style="color:#ef4444">♥</span> by <a href="https://www.senthilsweb.com" class="hover:text-foreground hover:underline">www.senthilsweb.com</a>.
    </footer>
  </div>
  <script>
    // Sign in is offered to someone who is not signed in, on a server that has accounts
    const link = document.getElementById("sign-in") as HTMLAnchorElement | null;
    if (link) fetch(link.href.replace(/login\/$/, "api/v1/info"), { credentials: "same-origin" })
      .then((r) => (r.ok ? r.json() : null))
      .then((info) => { if (info?.accounts && !info.signedIn) link.hidden = false; })
      .catch(() => { /* the page works without it */ });
  </script>
</Base>
