---
import "../styles/global.css";
interface Props { title: string; description?: string }
const { title, description = "Open-source, self-hosted agentic AI for social media authoring and management: design cards, draft posts with an assistant, and publish." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16130e" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`.replace(/\/\//g, "/")} />
    <title>{title}</title>
    <script is:inline>
      try {
        // first paint follows the choice kept in this browser (or the system); the server's is applied once it loads
        const saved = JSON.parse(localStorage.getItem("cardpress.appearance") || "{}");
        const dark = saved.mode === "dark" || (saved.mode !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.documentElement.dataset.palette = saved.theme || "parchment";
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
