---
// The CardPress mark: a gold card with two text lines and a sparkle.
const { size = 34 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 34 34" aria-hidden="true" class="shrink-0">
  <rect x="2.5" y="3.5" width="25" height="23" rx="7.5" class="fill-gold" />
  <rect x="8" y="11" width="14" height="2.4" rx="1.2" class="fill-foreground" opacity="0.85" />
  <rect x="8" y="16" width="9" height="2.4" rx="1.2" class="fill-foreground" opacity="0.55" />
  <path d="M27 19Q27.9 25.1 34 26Q27.9 26.9 27 33Q26.1 26.9 20 26Q26.1 25.1 27 19Z" class="stroke-background fill-foreground" stroke-width="3" stroke-linejoin="round" paint-order="stroke" />
</svg>
